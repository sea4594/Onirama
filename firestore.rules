rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /oniramaRooms/{code} {
      function signedIn() { return request.auth != null; }
      function member() { return signedIn() && (request.auth.uid == resource.data.hostUid || request.auth.uid == resource.data.guestUid); }
      function hostSeat() { return resource.data.get('hostSeat', 0); }
      function host() { return member() && ((hostSeat() == 0 && request.auth.uid == resource.data.hostUid) || (hostSeat() == 1 && request.auth.uid == resource.data.guestUid)); }
      function ended() { return resource.data.get('ended', false) == true; }
      function nextVersion() { return request.resource.data.version == resource.data.version + 1; }
      function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
      function seat() { return request.auth.uid == resource.data.hostUid ? 0 : 1; }
      // A nonmember may CLAIM a vacant seat with a blind update, but cannot
      // read the document (which contains the other player's private cards).
      function claimSeat0() {
        return !ended() && resource.data.hostUid == null && request.auth.uid != resource.data.guestUid &&
          request.resource.data.hostUid == request.auth.uid && request.resource.data.hostName is string &&
          request.resource.data.hostName.size() > 0 && request.resource.data.hostName.size() <= 40 &&
          changedOnly(['hostUid','hostName','updatedAt','version']);
      }
      function claimSeat1() {
        return !ended() && resource.data.guestUid == null && request.auth.uid != resource.data.hostUid &&
          request.resource.data.guestUid == request.auth.uid && request.resource.data.guestName is string &&
          request.resource.data.guestName.size() > 0 && request.resource.data.guestName.size() <= 40 &&
          changedOnly(['guestUid','guestName','updatedAt','version']);
      }
      function readyChange() {
        return member() && !ended() && resource.data.game == null &&
          changedOnly(['ready','updatedAt','version']) && request.resource.data.ready.size() == 2 &&
          request.resource.data.ready[1-seat()] == resource.data.ready[1-seat()];
      }
      function starting() {
        return host() && !ended() && resource.data.game == null &&
          resource.data.hostUid != null && resource.data.guestUid != null &&
          resource.data.ready == [true,true] && request.resource.data.game is map &&
          request.resource.data.game.mode == 'coop' && changedOnly(['game','updatedAt','version']);
      }
      function playing() {
        return member() && !ended() && resource.data.hostUid != null && resource.data.guestUid != null &&
          resource.data.game is map && resource.data.game.status == 'active' &&
          resource.data.game.active == seat() && request.resource.data.game is map &&
          changedOnly(['game','updatedAt','version']);
      }
      function departing() {
        return member() && !ended() &&
          changedOnly(['hostUid','hostName','guestUid','guestName','hostSeat','ready','ended','game','updatedAt','version']) &&
          request.resource.data.ready.size() == 2 &&
          request.resource.data.ready[seat()] == false &&
          request.resource.data.ready[1-seat()] == resource.data.ready[1-seat()] &&
          ((seat() == 0 && request.resource.data.hostUid == null && request.resource.data.hostName == '' &&
            request.resource.data.guestUid == resource.data.guestUid && request.resource.data.guestName == resource.data.guestName) ||
           (seat() == 1 && request.resource.data.guestUid == null && request.resource.data.guestName == '' &&
            request.resource.data.hostUid == resource.data.hostUid && request.resource.data.hostName == resource.data.hostName)) &&
          ((resource.data.hostUid != null && resource.data.guestUid != null &&
            request.resource.data.hostSeat == 1-seat() && request.resource.data.get('ended',false) == false &&
            request.resource.data.game == resource.data.game) ||
           (resource.data.hostUid == null || resource.data.guestUid == null) &&
            request.resource.data.get('ended',false) == true && request.resource.data.game == null);
      }
      function ending() {
        return host() && !ended() && request.resource.data.ended == true &&
          request.resource.data.game == null && changedOnly(['ended','game','updatedAt','version']);
      }
      allow get: if member();
      allow list: if false;
      allow create: if signedIn() && code.matches('^([A-Z]{4}|[A-F0-9]{8})$') &&
        request.resource.data.keys().hasOnly(['code','hostUid','guestUid','hostName','guestName','hostSeat','ended','config','ready','game','version','createdAt','updatedAt','expiresAt']) &&
        request.resource.data.keys().hasAll(['code','hostUid','guestUid','hostName','guestName','hostSeat','ended','config','ready','game','version','createdAt','updatedAt','expiresAt']) &&
        request.resource.data.code == code && request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.hostName is string && request.resource.data.hostName.size() <= 40 &&
        request.resource.data.guestUid == null && request.resource.data.guestName == '' &&
        request.resource.data.hostSeat == 0 && request.resource.data.ended == false &&
        request.resource.data.game == null && request.resource.data.version == 0 &&
        request.resource.data.ready == [false,false] &&
        request.resource.data.createdAt is int && request.resource.data.expiresAt is int;
      allow update: if signedIn() && nextVersion() &&
        (claimSeat0() || claimSeat1() || readyChange() || starting() || playing() || departing() || ending());
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
